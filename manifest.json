{
  "manifest_version": 3,
  "name": "DP / WD / SCB Live Validator",
  "version": "1.0.0",
  "description": "Memindai tabel DP, WD, dan SCB yang sedang dibuka lalu memvalidasi kandidat BNS secara lokal.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://bfj.porta-assist.com/_SubAg_Sub/*"
  ],
  "action": {
    "default_title": "BNS Validator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  }
}
